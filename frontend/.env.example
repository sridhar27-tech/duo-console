# ── Duo Console — Frontend Environment Example ───────────────────────────────
# Rename this file to .env and fill in the values before starting the dev server.
# .env is gitignored — this file is the only one committed to source control.

# ── Socket Server ─────────────────────────────────────────────────────────────
# Local dev:   http://localhost:3000
# Live tunnel: https://<your-subdomain>.ngrok-free.app
VITE_SOCKET_URL=http://localhost:3000

# ── Auth Token ────────────────────────────────────────────────────────────────
# Must match AUTH_TOKEN in duo-console-core/server.js.
# Generate a strong random value, e.g.: openssl rand -hex 32
VITE_AUTH_TOKEN=duo-console-secret-2025

# ── Auto-Connect (optional host shortcut) ─────────────────────────────────────
# When BOTH VITE_SOCKET_URL and VITE_DEFAULT_PSK are non-empty the app skips
# the connect screen and jumps straight to the chat session.
# Leave VITE_DEFAULT_PSK blank to always show the connect screen (recommended
# for the guest — they should always enter the PSK manually).
VITE_DEFAULT_PSK=

# ── Cloudinary (image + canvas snapshot upload) ───────────────────────────────
# Create a free account at https://cloudinary.com, then:
#   1. Copy your Cloud Name from the dashboard.
#   2. Create an unsigned upload preset and paste its name below.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here
